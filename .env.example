# 复制这个文件为 .env，并填入真实值

# 当前支持: openai / deepseek / aihubmix（都是OpenAI兼容格式）
# 翻译/抽取：用 deepseek，便宜
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

# 一致性QA判官：走 AIHubMix（聚合平台，一个key调强模型），用 GPT-5 Mini。
# deepseek做QA噪音大、易跑偏，换强判官更准。不配 QA_LLM_PROVIDER 时QA回退用 deepseek。
QA_LLM_PROVIDER=aihubmix
QA_LLM_MODEL=gpt-5-mini

# 流畅度审校判官（可选，--fluency 用）：不配则和一致性QA同模型。
# 小语种（阿语等）单语审校吃语感，可单独换更强的模型（如 gpt-5）。
# REASONING_EFFORT（minimal/low/medium/high）只对推理模型生效；
# EXP-011 实测这个任务用 minimal 就够：质量=medium/high、成本降~85%。
# FLUENCY_LLM_PROVIDER=aihubmix
# FLUENCY_LLM_MODEL=gpt-5
# FLUENCY_REASONING_EFFORT=minimal

OPENAI_API_KEY=sk-your-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
AIHUBMIX_API_KEY=sk-your-aihubmix-key-here
