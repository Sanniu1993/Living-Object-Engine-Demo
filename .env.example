# 复制这个文件为 .env，并填入真实值

# 当前支持: openai / deepseek / aihubmix（都是OpenAI兼容格式）
# 翻译/抽取：用 deepseek，便宜
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# QA判官：走 AIHubMix（聚合平台，一个key调强模型），用 GPT-5 Mini。
# deepseek做QA噪音大、易跑偏，换强判官更准。不配 QA_LLM_PROVIDER 时QA回退用 deepseek。
QA_LLM_PROVIDER=aihubmix
QA_LLM_MODEL=gpt-5-mini

OPENAI_API_KEY=sk-your-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
AIHUBMIX_API_KEY=sk-your-aihubmix-key-here
