# 复制这个文件为 .env，并填入真实值

# 当前支持: openai / deepseek（以后要换OpenRouter/Azure，加对应实现后改这里）
# 调试阶段先用 deepseek，便宜，API兼容OpenAI格式
LLM_PROVIDER=deepseek

# 模型名做成配置项，方便随时切换，不需要改代码
LLM_MODEL=deepseek-chat

# QA判官：接口已留好，现在先注释掉——不配 QA_LLM_PROVIDER 时QA自动回退用 deepseek。
# 以后想换更强的模型当判官（deepseek做QA噪音大、易跑偏），取消下面两行注释并填好 OPENAI_API_KEY 即可。
# QA_LLM_PROVIDER=openai
# QA_LLM_MODEL=gpt-4o

OPENAI_API_KEY=sk-your-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
